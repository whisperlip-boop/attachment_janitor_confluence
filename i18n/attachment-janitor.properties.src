# --- state and banners -------------------------------------------------------

aj.state.never = No scan has run yet. Press "Scan now" to measure this instance.
aj.state.noresults = No scan has finished yet, so there are no numbers to show.
aj.state.nodetail = The per-attachment rows for this scan are no longer stored. Run a scan \
to rebuild them.
aj.state.loading = Loading...
aj.state.empty = The scan found no attachments.
aj.state.nomatch = No attachment matches these filters.
aj.state.scanning = {0}: {1} processed.
aj.state.cancelled = The last scan was cancelled, so it stored no numbers.
aj.state.failed = The last scan failed and stored no numbers: {0}
aj.state.stale = The table below is from the last scan that finished, not the one above.
aj.state.skipped = {0} attachments could not be read and are not in these totals.
aj.state.parsefail = {0} page bodies could not be read. References in them were not counted, \
so an attachment may be shown as unreferenced when it is not.
aj.state.unresolved = {0} references point at a page that could not be found - renamed or \
deleted. Those references were not counted.
aj.state.hashbudget = The scan reached its hashing limit, so some duplicate candidates were \
not checked. Raise the limit in Settings if you need the full picture.
aj.state.nohistory = Past versions of page bodies were not examined, so an attachment used \
only by an older version is shown as "Unreferenced (history not checked)". Turn it on in \
Settings.

aj.phase.none = Working
aj.phase.attachments = Reading attachments
aj.phase.bodies = Reading page bodies
aj.phase.match = Matching references
aj.phase.duplicates = Comparing file contents
aj.phase.save = Saving

aj.asof = As of {0}

aj.note.nospace = "(no space)" is attachments that belong to no space, such as profile \
pictures. They are listed so the space rows add up to the instance total.

aj.error.forbidden = Your administrator session has expired, or you are not a Confluence \
administrator. Reload the page and log in again.
aj.error.network = Could not reach Confluence. The numbers shown may be out of date.
aj.error.websudo = Your administrator confirmation has expired. Reload this screen and confirm your password again before removing anything.
aj.error.busy = Another job is already running \
  — a scan, or a cleanup of older versions. On a cluster it may be running on a different node.

# --- labels ------------------------------------------------------------------
# One set per Label enum constant. Adding a constant adds a row to the help page too.

aj.label.name.active = In use
aj.label.cond.active = Referenced by the current body of the page it is attached to
aj.label.act.active = Leave it alone. Removing it breaks the page it sits on.

aj.label.name.risky = Used elsewhere
aj.label.cond.risky = Referenced from somewhere other than the page it is attached to
aj.label.act.risky = The most dangerous one to remove. Open "Used by" and check every page \
listed - looking at the page the file is attached to will not show you what breaks.

aj.label.name.history = History only
aj.label.cond.history = Not in any current body, only in past versions of one
aj.label.act.history = Removing it breaks nothing visible today, but opening an older \
version of the page will show a broken image. Keep it if version history matters to you.

aj.label.name.draft = On a draft
aj.label.cond.draft = Attached to an unsaved draft page
aj.label.act.draft = Wait. Draft bodies are not counted as references because nobody else \
can see them, so this means "not judged yet", not "not used".

aj.label.name.orphan = Unreferenced
aj.label.cond.orphan = No reference found anywhere this app looked
aj.label.act.orphan = The first thing to review. Read the limits below before treating it \
as safe to delete.
aj.label.name.orphan_unchecked = Unreferenced (history not checked)

# --- badges ------------------------------------------------------------------

aj.badge.name.oldversions = Many old versions
aj.badge.desc.oldversions = The file was re-uploaded repeatedly. Only the newest shows on the \
page; the rest are still on disk.
aj.badge.name.duplicate = Duplicate
aj.badge.name.duplicate_maybe = Possible duplicate
aj.badge.desc.duplicate = The same content exists somewhere else in this instance.
aj.badge.name.large = Large
aj.badge.desc.large = The current version alone is over the size threshold.
aj.badge.name.stale = Untouched
aj.badge.desc.stale = Nothing has changed it for a long time. On its own this means nothing - \
an old file can be in daily use.

