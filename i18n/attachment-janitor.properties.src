# Attachment Janitor - English strings (default bundle).
# Edit this file, then run tools/make-i18n.py. Do not edit src/main/resources/*.properties.
#
# Everything under "aj." except "aj.help." is handed to the browser as one bundle, so a new
# string needs no wiring anywhere else. Keys are deliberately not listed by hand in code.

aj.admin.section.label = Attachment storage report

aj.admin.title = Attachment Janitor
aj.admin.lede = Where attachment storage actually goes: per-space totals, how much of each \
space is superseded versions of files that look like one file on screen, and which \
attachments no page body references any more.
aj.admin.limits = The only thing this app removes is superseded versions, and only after a preview you confirm. It never removes an attachment or a page.
aj.admin.helplink = How to read this screen

aj.detail.lede = Every attachment in this space, with what would break if you removed it and \
the evidence behind that judgement.
aj.duplicates.lede = Files whose contents are the same. "Reclaimable" is what you would get \
back by keeping one copy.
aj.settings.lede = Thresholds for the flags, and how far a scan goes. Changes take effect on \
the next scan.

aj.nav.spaces = Spaces
aj.nav.duplicates = Duplicates
aj.nav.settings = Settings
aj.nav.help = Help

aj.action.scan = Scan now
aj.action.scanning = Scanning...
aj.action.cancel = Cancel
aj.action.csv = Export CSV
aj.action.save = Save

