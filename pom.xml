<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>co.bskim.confluence</groupId>
    <artifactId>attachment-janitor</artifactId>
    <version>1.2.0</version>

    <organization>
        <name>BSKIM Company</name>
        <url>https://github.com/whisperlip-boop</url>
    </organization>

    <name>Attachment Janitor</name>
    <description>Attachment storage reporting for Confluence administrators, with one clean-up action. Ranks spaces by attachment storage, exposes the old versions hidden behind a single filename, finds duplicate uploads, and works out which attachments no page body references any more - with the referencing pages shown as evidence. Korean and English. The only thing it can remove is superseded versions of an attachment, always keeping the current one and however many recent versions you choose, after a preview you have to confirm. It never deletes an attachment, a page, or anything you have not reviewed.</description>
    <packaging>atlassian-plugin</packaging>

    <dependencies>
        <dependency>
            <groupId>com.atlassian.confluence</groupId>
            <artifactId>confluence</artifactId>
            <version>${confluence.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.atlassian.activeobjects</groupId>
            <artifactId>activeobjects-plugin</artifactId>
            <version>${ao.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.atlassian.plugin</groupId>
            <artifactId>atlassian-spring-scanner-annotation</artifactId>
            <version>${atlassian.spring.scanner.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>jsr311-api</artifactId>
            <version>1.1.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 4 needs this at run time and the Atlassian parent does not bring it in. -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-core</artifactId>
            <version>1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.atlassian.maven.plugins</groupId>
                <artifactId>confluence-maven-plugin</artifactId>
                <version>${amps.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <!--
                        실행 버전은 컴파일 버전과 별도 축이다. 둘을 한 속성으로 묶으면
                        -Pconf7123 이 컴파일까지 7.12.3 으로 올려 "7.12.3 으로 컴파일한
                        jar 을 7.12.3 에서 돌리는" 무의미한 시험이 된다.
                    -->
                    <productVersion>${confluence.runtime.version}</productVersion>
                    <productDataVersion>${confluence.runtime.data.version}</productDataVersion>
                    <enableQuickReload>true</enableQuickReload>

                    <instructions>
                        <Atlassian-Plugin-Key>${atlassian.plugin.key}</Atlassian-Plugin-Key>
                        <Export-Package/>
                        <Import-Package>*</Import-Package>
                        <Spring-Context>*</Spring-Context>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.atlassian.plugin</groupId>
                <artifactId>atlassian-spring-scanner-maven-plugin</artifactId>
                <version>${atlassian.spring.scanner.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>atlassian-spring-scanner</goal>
                        </goals>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
                <configuration>
                    <verbose>false</verbose>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <!--
            Compile low, run high: the deployment target is 7.12.3 but the compile target is the
            7.8.1 the development instance runs, so nothing newer than 7.8.1 can be referenced by
            accident. docs/00-환경실측.md records what was measured on 7.8.1.
        -->
        <confluence.version>7.8.1</confluence.version>
        <confluence.data.version>7.8.1</confluence.data.version>
        <!-- atlas-run 이 띄우는 버전. conf7123 프로필이 이것만 올린다. -->
        <confluence.runtime.version>${confluence.version}</confluence.runtime.version>
        <confluence.runtime.data.version>${confluence.data.version}</confluence.runtime.data.version>
        <amps.version>8.1.2</amps.version>
        <!-- The version Confluence 7.8.1 bundles (activeobjects-plugin-3.2.4.jar). -->
        <ao.version>3.2.4</ao.version>
        <atlassian.spring.scanner.version>2.1.7</atlassian.spring.scanner.version>
        <atlassian.plugin.key>${project.groupId}.${project.artifactId}</atlassian.plugin.key>
        <!--
            Appended to the reported version. Confluence keys web-resource URLs on the plugin
            version and serves them immutable, so reinstalling the same version leaves browsers
            on the previous build's JavaScript. deploy.sh sets this to the build time; a release
            build leaves it empty and the version is exactly what this pom says.
        -->
        <aj.build.qualifier/>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <profiles>
        <!--
          운영 타깃(7.12.3)에서 실제로 돌려 보는 프로필. 검증 전용이고 배포 산출물에는
          영향이 없다.

              sleep infinity | atlas-run -Pconf7123
              → http://localhost:1990/confluence   admin / admin
                AMPS 가 개발용 timebomb 라이선스를 자동으로 넣는다.

          **컴파일 버전은 올리지 않는다.** `confluence.version` 은 7.8.1 그대로고
          실행 버전만 7.12.3 이 된다. 그래야 "낮은 쪽으로 컴파일한 jar 이 높은 쪽에서
          도는가"를 검증한다. 확인:

              atlas-mvn -Pconf7123 dependency:list | grep 'confluence:confluence:'
              → 7.8.1 이 나와야 한다

          `-Dconfluence.version=7.12.3` 으로 하는 컴파일 검사(실측 19번)와는 다른
          레버다. 그쪽은 컴파일 API, 이쪽은 런타임. 합치지 말 것.

          주의: atlas-run 은 H2 를 쓴다. PostgreSQL 방언 검증은 docker 7.8.1 인스턴스가
          담당한다. 두 환경이 서로 다른 축을 덮으므로 어느 하나로 대체되지 않는다.
        -->
        <profile>
            <id>conf7123</id>
            <properties>
                <confluence.runtime.version>7.12.3</confluence.runtime.version>
                <confluence.runtime.data.version>7.12.3</confluence.runtime.data.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.atlassian.maven.plugins</groupId>
                        <artifactId>confluence-maven-plugin</artifactId>
                        <version>${amps.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- 7.12 는 AMPS 기본 힙으로는 기동 중에 죽는다. -->
                            <jvmArgs>-Xms1g -Xmx2g -XX:MaxMetaspaceSize=512m</jvmArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
